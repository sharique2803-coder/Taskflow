# Copy this to .env — fill in real values in Vercel dashboard

PORT=5000

# Vercel Postgres — get both from Vercel dashboard after adding Postgres storage
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Generate a strong random string: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# Your frontend Vercel URL (no trailing slash)
FRONTEND_URL=https://your-frontend.vercel.app
